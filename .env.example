# Copy this file to ".env" and fill in your Supabase project values.
# These are exposed to the browser (the anon key is safe to expose; Row Level
# Security is what protects your data). Never put service-role keys here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
